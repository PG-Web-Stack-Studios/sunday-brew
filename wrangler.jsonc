// Para la etapa en Cloudflare (después del preview en GitHub Pages).
{
  "name": "sunday-brew",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "EMAIL_FROM": "bookings@sundaybrewcoffeeaz.com"
  }
  // Secretos (wrangler secret put / panel de Cloudflare):
  // SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, BOOKING_NOTIFY_TO
}
